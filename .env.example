# Alinha backend — environment variables.
# Copy to `.env` and fill in your own values. Never commit the real `.env`.

# --- Database (PostgreSQL) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=vapor_database
DATABASE_USERNAME=vapor_username
DATABASE_PASSWORD=vapor_password

# --- Logging ---
LOG_LEVEL=debug

# --- APNs push notifications (optional) ---
# If these are unset, the app runs with push notifications disabled.
APNS_TOPIC=.com.example.Alinha
APNS_KEY_ID=
APNS_TEAM_ID=
# Paste the full contents of your AuthKey_XXXXXXXXXX.p8 here.
APNS_PRIVATE_KEY=
